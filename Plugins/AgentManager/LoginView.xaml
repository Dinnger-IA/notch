<UserControl x:Class="AgentManagerNotch.Plugins.AgentManager.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AgentManagerNotch.Controls">
    <!-- Inicio de sesión con Agent Manager: la puerta de acceso antes de ver los agentes -->
    <Border CornerRadius="22" Background="{DynamicResource PaneBg}" Padding="22,16,22,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <c:MochiView x:Name="LoginMochi" Width="96" Height="96" BodyColor="#9C8CFF" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Inicia sesión con Agent Manager" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="LoginStatus" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondary}"
                           Text="Para ver y usar tus agentes, entra con tu cuenta de Agent Manager. Se abrirá el navegador."/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="LoginButton" Content="Iniciar sesión" MinWidth="130" Click="Login_Click"
                            Style="{DynamicResource AccentButtonStyle}"/>
                    <Button x:Name="LoginCancelButton" Content="Cancelar" MinWidth="100" Margin="8,0,0,0"
                            Click="LoginCancel_Click" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

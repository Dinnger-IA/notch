<Window x:Class="AgentManagerNotch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AgentManagerNotch.Controls"
        xmlns:v="clr-namespace:AgentManagerNotch.Views"
        xmlns:m="clr-namespace:AgentManagerNotch.Models"
        xmlns:s="clr-namespace:AgentManagerNotch.Services"
        Title="Agent Manager Notch" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="860" Height="700" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <v:NullToVisibilityConverter x:Key="NullToVis"/>
        <v:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <v:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <v:ColorToBrushConverter x:Key="ColorBrush"/>
        <v:EmptyToVisibilityConverter x:Key="EmptyToVis"/>

        <RadialGradientBrush x:Key="ChatBackground" Center="0.5,1.05" GradientOrigin="0.5,1.05" RadiusX="0.75" RadiusY="0.95">
            <GradientStop Color="#2A2650" Offset="0"/>
            <GradientStop Color="#16152A" Offset="0.55"/>
            <GradientStop Color="#0C0C10" Offset="1"/>
        </RadialGradientBrush>

        <SolidColorBrush x:Key="PaneBg" Color="#121217"/>
        <SolidColorBrush x:Key="ChipBg" Color="#1A1A21"/>

        <!-- Configuración: tarjetas, títulos y filas con el mismo espaciado -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaneBg}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SettingsTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6E6E7C"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#ECECF2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TopPill" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Mensajes estilo coucou -->
        <DataTemplate x:Key="Message" DataType="{x:Type m:ChatMessage}">
            <Border x:Name="Bubble" Margin="0,6" Padding="0" CornerRadius="16" MaxWidth="500"
                    HorizontalAlignment="Left" Background="Transparent">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copiar" Click="CopyMessage_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <RichTextBox x:Name="Md" Style="{StaticResource SelectableDoc}" FontSize="13.5"
                                 Foreground="#ECECF2" Block.LineHeight="20" v:Markdown.Text="{Binding Text}">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copiar selección" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="Copiar mensaje" Click="CopyMessage_Click"/>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                    <TextBox x:Name="Txt" Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                             FontSize="13.5" Visibility="Collapsed"/>
                    <!-- Error con salida: la sesión de Codex está ocupada en otro programa -->
                    <Button x:Name="NewSessionButton" Grid.Row="1" Content="Seguir en una sesión nueva" Style="{StaticResource SettingsButton}"
                            Margin="0,8,0,2" Visibility="Collapsed" Click="ContinueInNewSession_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static m:ChatRole.User}">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="#2C2C33"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="14,7"/>
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="420"/>
                    <Setter TargetName="Md" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Txt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static m:ChatRole.Tool}">
                    <Setter TargetName="Md" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Txt" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Margin" Value="0,0"/>
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="560"/>
                    <Setter TargetName="Txt" Property="FontFamily" Value="{StaticResource MonoFont}"/>
                    <Setter TargetName="Txt" Property="FontSize" Value="11"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="#6E6E7C"/>
                    <Setter TargetName="Txt" Property="TextWrapping" Value="NoWrap"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static m:ChatRole.Notice}">
                    <Setter TargetName="Md" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Txt" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                    <Setter TargetName="Bubble" Property="Margin" Value="0,3"/>
                    <Setter TargetName="Txt" Property="FontSize" Value="11"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="#6E6E7C"/>
                    <Setter TargetName="Txt" Property="TextAlignment" Value="Center"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static m:ChatRole.Error}">
                    <Setter TargetName="Md" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Txt" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource ErrorBg}"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="12,7"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource ErrorFg}"/>
                    <Setter TargetName="Txt" Property="FontSize" Value="12"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}" Value="{x:Static m:ChatMessage.ActionNewSession}">
                    <Setter TargetName="NewSessionButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Acción del agente (leer, escribir, ejecutar…) en el panel bajo el personaje -->
        <v:ToolActionConverter x:Key="ToolAction"/>
        <DataTemplate x:Key="ActionLineTemplate" DataType="{x:Type m:ChatMessage}">
            <Grid>
            <Grid x:Name="ActionRow" Margin="0,3" ToolTip="{Binding Text}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text, Converter={StaticResource ToolAction}, ConverterParameter=icon}"
                           FontFamily="{StaticResource IconFont}" FontSize="10.5" Foreground="#8C8C99" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Text, Converter={StaticResource ToolAction}, ConverterParameter=name}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#C8C8D2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Text, Converter={StaticResource ToolAction}, ConverterParameter=detail}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#6E6E7C"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{Binding Text, Converter={StaticResource ToolAction}, ConverterParameter=detailvis}"/>
                </StackPanel>
            </Grid>
            <!-- Permiso: tarjeta con la decisión (permitido / permitido siempre / denegado) -->
            <Border x:Name="PermissionRow" Visibility="Collapsed" Margin="0,4" Padding="7,5" CornerRadius="8"
                    BorderThickness="1" Background="#1A4DD0A1" BorderBrush="#664DD0A1" ToolTip="{Binding Text}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PermIcon" Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#4DD0A1"
                               VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="PermLabel" Text="Permitido" FontSize="9.5" FontWeight="SemiBold" Foreground="#4DD0A1"/>
                        <TextBlock Text="{Binding Text, Converter={StaticResource ToolAction}, ConverterParameter=name}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#ECECF2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Text, Converter={StaticResource ToolAction}, ConverterParameter=detail}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#9A9AA8"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Visibility="{Binding Text, Converter={StaticResource ToolAction}, ConverterParameter=detailvis}"/>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static m:ChatRole.Permission}">
                    <Setter TargetName="ActionRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="PermissionRow" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="AllowAlways">
                    <Setter TargetName="PermLabel" Property="Text" Value="Permitido siempre"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="Deny">
                    <Setter TargetName="PermLabel" Property="Text" Value="Denegado"/>
                    <Setter TargetName="PermLabel" Property="Foreground" Value="#FF8A8A"/>
                    <Setter TargetName="PermIcon" Property="Foreground" Value="#FF8A8A"/>
                    <Setter TargetName="PermIcon" Property="Text" Value="&#xE733;"/>
                    <Setter TargetName="PermissionRow" Property="Background" Value="#1AFF8A8A"/>
                    <Setter TargetName="PermissionRow" Property="BorderBrush" Value="#66FF8A8A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Línea de detalle grande (tarjeta izquierda de la vista general) -->
        <DataTemplate x:Key="DetailLineTemplate" DataType="{x:Type m:TaskLine}">
            <Grid Margin="0,3" ToolTip="{Binding Detail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Ic" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="#8C8C99" Margin="0,3,0,0"/>
                <TextBlock x:Name="Tx" Grid.Column="1" Text="{Binding Text}" FontSize="13" Foreground="#9A9AA8"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static m:TaskTone.Done}">
                    <Setter TargetName="Ic" Property="Foreground" Value="#8C8C99"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static m:TaskTone.Failed}">
                    <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource ErrorFg}"/>
                    <Setter TargetName="Tx" Property="Foreground" Value="#E8B4B4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static m:TaskTone.Running}">
                    <Setter TargetName="Ic" Property="Text" Value="&#xE76C;"/>
                    <Setter TargetName="Ic" Property="Foreground" Value="#ECECF2"/>
                    <Setter TargetName="Tx" Property="Foreground" Value="#ECECF2"/>
                    <Setter TargetName="Tx" Property="FontSize" Value="14"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static m:TaskTone.Pending}">
                    <Setter TargetName="Ic" Property="Text" Value="&#xE76C;"/>
                    <Setter TargetName="Ic" Property="Foreground" Value="#5E5E6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static m:TaskTone.Schedule}">
                    <Setter TargetName="Ic" Property="Foreground" Value="#8EB8FF"/>
                    <Setter TargetName="Tx" Property="Foreground" Value="#C8C8D2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static m:TaskTone.Bullet}">
                    <Setter TargetName="Ic" Property="Foreground" Value="#4DD0A1"/>
                    <Setter TargetName="Ic" Property="FontSize" Value="7"/>
                    <Setter TargetName="Ic" Property="Margin" Value="2,6,0,0"/>
                    <Setter TargetName="Tx" Property="Foreground" Value="#D6D6DE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static m:TaskTone.Next}">
                    <Setter TargetName="Ic" Property="Foreground" Value="#ECECF2"/>
                    <Setter TargetName="Tx" Property="Foreground" Value="#ECECF2"/>
                    <Setter TargetName="Tx" Property="FontSize" Value="14"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Chip pequeño de un agente (panel derecho) -->
        <DataTemplate x:Key="AgentChip" DataType="{x:Type s:AgentEntry}">
            <Border x:Name="Chip" Height="42" Margin="4" CornerRadius="21" Background="{StaticResource ChipBg}"
                    BorderBrush="#1FFFFFFF" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonUp="Chip_Click" MouseRightButtonUp="Chip_RightClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                        <c:MochiView Width="30" Height="30" Interactive="False"
                                     BodyColor="{Binding Color}" State="{Binding State}" IsBox="{Binding IsBox}"/>
                        <!-- Insignias -->
                        <Border Width="14" Height="14" CornerRadius="7" Background="#E5484D" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-5,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="7" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource AlertBorder}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-5,0" Visibility="{Binding NeedsApproval, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="#1A1300"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#D6D6DE"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,12,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="#26263A"/>
                    <Setter TargetName="Chip" Property="BorderBrush" Value="#40FFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="#55FFB020"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Elemento de la vista de tareas programadas -->
        <DataTemplate x:Key="ScheduledItemTemplate" DataType="{x:Type v:ScheduledItem}">
            <Border x:Name="Row" Padding="8,6" Margin="0,1" CornerRadius="12" Background="Transparent" ToolTip="{Binding Tooltip}"
                    Cursor="Hand" MouseLeftButtonUp="ScheduledItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:MochiView Width="28" Height="28" Interactive="False" BodyColor="{Binding Color}"/>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="#ECECF2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="11" Foreground="#8C8C99" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                            <Run Text="{Binding When, Mode=OneWay}" Foreground="#C8C8D2"/><Run Text="  ·  "/><Run Text="{Binding Meta, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE74D;"
                            ToolTip="Eliminar" Click="DeleteReminder_Click" VerticalAlignment="Center"
                            Visibility="{Binding IsReminder, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#14FFFFFF"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Pestaña de workspace (agentes de código) -->
        <DataTemplate x:Key="WorkspaceTab" DataType="{x:Type s:AgentSession}">
            <Border x:Name="Tab" Height="30" Margin="0,0,4,0" Padding="10,0,4,0" CornerRadius="15" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding FolderPath}" MouseLeftButtonUp="Tab_Click" MouseRightButtonUp="Tab_RightClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Ic" Text="{Binding TabIcon}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#8C8C99"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FolderName}" FontSize="12" Foreground="#D6D6DE" Margin="6,0,2,0" VerticalAlignment="Center"
                               MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                    <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="8" Content="&#xE711;" ToolTip="Cerrar workspace"
                            Click="CloseTab_Click"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tab" Property="Background" Value="#2C2C33"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TabTone}" Value="{x:Static m:TaskTone.Running}">
                    <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource AlertBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TabTone}" Value="{x:Static m:TaskTone.Done}">
                    <Setter TargetName="Ic" Property="Foreground" Value="#4DD0A1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TabTone}" Value="{x:Static m:TaskTone.Failed}">
                    <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource ErrorFg}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Shell" VerticalAlignment="Top" HorizontalAlignment="Center"
                Width="150" Height="30" CornerRadius="0,0,10,10"
                Background="{StaticResource NotchBg}" BorderBrush="{StaticResource NotchBorder}" BorderThickness="1,0,1,1"
                AllowDrop="True" MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave"
                DragEnter="Shell_DragEnter" DragLeave="Shell_DragLeave" Drop="Shell_Drop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <Grid ClipToBounds="True">

                <!-- ============ Píldora ============ -->
                <Grid x:Name="CollapsedView" Margin="12,0,12,0" MouseLeftButtonUp="Collapsed_Click">
                    <!-- Los personajes se dibujan "apoyados" abajo en su recuadro: se suben un poco para que se vean centrados -->
                    <StackPanel x:Name="CollapsedContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,-6,0,0">
                        <StackPanel x:Name="CollapsedAgents" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CollapsedStatus" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="240"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Aviso ============ -->
                <Grid x:Name="BannerView" Visibility="Collapsed" Opacity="0" Margin="16,8,16,10" Cursor="Hand"
                      MouseLeftButtonUp="Banner_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:MochiView x:Name="BannerMochi" Width="48" Height="48" Interactive="False"/>
                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BannerTitle" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerBody" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="BannerClose_Click" ToolTip="Cerrar"/>
                </Grid>

                <!-- ============ Panel abierto: barra superior fija + contenido ============ -->
                <Grid x:Name="PanelHost" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra superior: inicio a la izquierda; tareas programadas y configuración a la derecha -->
                    <Grid Margin="14,4,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="HomePill" CornerRadius="15" Background="#2C2C33">
                                <Button Style="{StaticResource TopPill}" Content="&#xE80F;" ToolTip="Inicio" Click="Home_Click" Foreground="#ECECF2"/>
                            </Border>
                            <TextBlock x:Name="TopTitle" Margin="12,0,0,0" FontSize="12" Foreground="#8C8C99" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="Fijar panel abierto" Click="Pin_Click"/>
                            <Border x:Name="SchedulePill" CornerRadius="15" Background="Transparent" Margin="2,0,0,0">
                                <Button Style="{StaticResource TopPill}" Content="&#xE787;" ToolTip="Tareas programadas" Click="ScheduleView_Click"/>
                            </Border>
                            <Border x:Name="SettingsPill" CornerRadius="15" Background="Transparent" Margin="2,0,0,0">
                                <Button x:Name="SettingsButton" Style="{StaticResource TopPill}" Content="&#xE713;" ToolTip="Configuración" Click="Settings_Click"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">

                <!-- ============ Versión nueva: el agente de actualización (antes de la vista general) ============ -->
                <v:UpdateCard x:Name="UpdateView" Visibility="Collapsed" Opacity="0" Margin="10,2,10,10"/>

                <!-- ============ Vista general: tarjeta grande + chips ============ -->
                <Grid x:Name="OverviewView" Visibility="Collapsed" Opacity="0" Margin="10,2,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Agente enfocado -->
                    <Border x:Name="FocusCard" CornerRadius="22" Background="{StaticResource PaneBg}" Padding="12,12,14,12"
                            Cursor="Hand" MouseLeftButtonUp="FocusCard_Click" MouseRightButtonUp="FocusCard_RightClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <c:MochiView x:Name="FocusMochi" Width="84" Height="84" VerticalAlignment="Center" Interactive="True"
                                         BodyColor="{Binding Color}" State="{Binding State}" IsBox="{Binding IsBox}"/>
                            <StackPanel x:Name="FocusInfo" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BackToPrincipal" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10"
                                                Content="&#xE76B;" ToolTip="Volver al principal" Click="BackToPrincipal_Click" Margin="0,0,4,0"/>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource ColorBrush}}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" Foreground="#ECECF2" VerticalAlignment="Center"
                                                   MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProviderLabel}" FontSize="12.5" Foreground="#6E6E7C" VerticalAlignment="Center" Margin="8,1,0,0"/>
                                        <Border x:Name="StatusChipBorder" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="#1FFFFFFF" Visibility="{Binding StatusChip, Converter={StaticResource EmptyToVis}}">
                                            <TextBlock x:Name="StatusChipText" Text="{Binding StatusChip}" FontSize="11.5" Foreground="#D6D6DE"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Counter}" FontSize="12.5" Foreground="#9A9AA8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="ScheduledRun" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE768;"
                                                ToolTip="Ejecutar ahora" Click="RunNow_Click"/>
                                        <Button x:Name="ScheduledPause" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11"
                                                Click="TogglePause_Click"/>
                                        <Border x:Name="OpenChatButton" Width="28" Height="28" CornerRadius="14" Background="#24FFFFFF">
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE8A7;"
                                                    ToolTip="Abrir chat" Click="OpenFocused_Click" Foreground="#ECECF2"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="SemiBold" Foreground="#F2F2F6" Margin="2,6,0,0"
                                           TextTrimming="CharacterEllipsis" Visibility="{Binding HasHeadline, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl x:Name="FocusLines" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource DetailLineTemplate}" Margin="2,6,0,0"/>
                                <!-- Más detalle (programados, al pulsar la tarjeta) -->
                                <StackPanel x:Name="ScheduledDetails" Visibility="Collapsed" Margin="2,10,0,0">
                                    <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,8"/>
                                    <TextBlock Text="ÚLTIMO RESULTADO" FontSize="10" FontWeight="SemiBold" Foreground="#6E6E7C"/>
                                    <TextBlock x:Name="DetailLastOutput" FontSize="12.5" Foreground="#D6D6DE" TextWrapping="Wrap" Margin="0,3,0,8" MaxHeight="110"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="INSTRUCCIÓN" FontSize="10" FontWeight="SemiBold" Foreground="#6E6E7C"/>
                                    <TextBlock x:Name="DetailInstruction" FontSize="12" Foreground="#9A9AA8" TextWrapping="Wrap" Margin="0,3,0,8" MaxHeight="70"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="PRÓXIMAS EJECUCIONES" FontSize="10" FontWeight="SemiBold" Foreground="#6E6E7C"/>
                                    <TextBlock x:Name="DetailNextRuns" FontSize="12" Foreground="#C8C8D2" Margin="0,3,0,8"/>
                                    <TextBlock x:Name="DetailMeta" FontSize="11" Foreground="#6E6E7C" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Resto de agentes -->
                    <Border Grid.Column="2" CornerRadius="22" Background="{StaticResource PaneBg}" Padding="8,8,8,8">
                        <ScrollViewer Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <StackPanel>
                                <ItemsControl x:Name="ChipList" ItemTemplate="{StaticResource AgentChip}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <UniformGrid Columns="2">
                                    <Border x:Name="AddChip" Height="42" Margin="4" CornerRadius="21" BorderBrush="#26FFFFFF" BorderThickness="1"
                                            Background="Transparent" Cursor="Hand" MouseLeftButtonUp="AddChip_Click">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" Foreground="#9A9AA8">
                                            <Run Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"/><Run Text="  Nuevo"/>
                                        </TextBlock>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Capa para la animación de intercambio entre el principal y el chip pulsado -->
                    <Canvas x:Name="SwapLayer" Grid.ColumnSpan="3" IsHitTestVisible="False"/>
                </Grid>

                <!-- ============ Chat ============ -->
                <Border x:Name="ChatView" Visibility="Collapsed" Opacity="0" Background="{StaticResource ChatBackground}" CornerRadius="22"
                        Margin="10,2,10,10" BorderBrush="#1AFFFFFF" BorderThickness="1">
                    <Grid Margin="12,8,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Personaje, a la altura de las pestañas -->
                        <c:MochiView x:Name="ChatMochi" Grid.Row="0" Grid.Column="0" Width="46" Height="46"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,-4,0,2"
                                     MouseLeftButtonUp="ChatMochi_Click"/>

                        <!-- Barra superior -->
                        <Grid Grid.Column="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ChatTitle" FontSize="14" FontWeight="SemiBold" Foreground="#ECECF2" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <Button x:Name="NewChatButton" Style="{StaticResource TopPill}" Content="&#xE710;" ToolTip="Nueva conversación" Click="NewChat_Click"/>
                            </StackPanel>
                            <!-- Pestañas de workspace (solo código) -->
                            <ScrollViewer x:Name="TabsScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          Margin="8,0,8,0" PreviewMouseWheel="Tabs_MouseWheel">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl x:Name="TabStrip" ItemTemplate="{StaticResource WorkspaceTab}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Button Style="{StaticResource TopPill}" Width="34" Content="&#xE8F4;" ToolTip="Nuevo workspace (elige o arrastra una carpeta)"
                                            Click="NewWorkspace_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Git del workspace (solo si la carpeta es un repositorio): rama y nº de cambios -->
                            <Button x:Name="GitButton" Grid.Column="2" Style="{StaticResource PillButton}" Padding="10,4" Visibility="Collapsed"
                                    Background="#1FFFFFFF" ToolTip="Cambios de git: preparar, ramas, commit y push" Click="GitToggle_Click">
                                <TextBlock FontSize="12">
                                    <Run Text="&#x2442;" FontFamily="Segoe UI Symbol" Foreground="#9A9AA8"/>
                                    <Run x:Name="GitButtonBranch"/>
                                    <Run x:Name="GitButtonCount" Foreground="#FFB020"/>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <!-- Acciones del agente debajo del personaje (leer, escribir, ejecutar…): ocupan toda la columna,
                             siempre lo más reciente y el resto difuminado. En el chat ya no aparecen. En los agentes de
                             código la más reciente va arriba y se ven 5; el resto, con scroll (RecentActions). -->
                        <Grid Grid.Row="1" Grid.RowSpan="3" Margin="0,2,0,0">
                            <ScrollViewer x:Name="TaskScroll" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto"
                                          Padding="2,2,10,2">
                                <ItemsControl x:Name="ActionsList" ItemTemplate="{StaticResource ActionLineTemplate}"/>
                            </ScrollViewer>
                            <ScrollViewer x:Name="RecentScroll" Visibility="Collapsed" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto"
                                          VerticalAlignment="Top" Padding="2,2,10,2" MouseEnter="RecentScroll_Hover" MouseLeave="RecentScroll_Hover"
                                          ScrollChanged="RecentScroll_ScrollChanged">
                                <StackPanel x:Name="RecentActions"/>
                            </ScrollViewer>
                            <TextBlock x:Name="NoActions" Text="Aquí verás lo que hace el agente: leer, editar, ejecutar…" FontSize="10.5"
                                       Foreground="#55555F" TextWrapping="Wrap" Margin="2,2,10,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Conversación -->
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="ContextPill" HorizontalAlignment="Left" CornerRadius="13" Background="#2C2C33" Padding="10,4,12,4" Margin="0,0,0,6"
                                    ToolTip="{Binding FolderPath}" Cursor="Hand" MouseLeftButtonUp="OpenFolder_Click">
                                <!-- En los agentes de código la carpeta ya se ve en la pestaña del workspace: no se repite -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Color, Converter={StaticResource ColorBrush}}" VerticalAlignment="Center"/>
                                    <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="#ECECF2" VerticalAlignment="Center">
                                        <Run Text="{Binding Profile.Name, Mode=OneWay}"/><Run Text=" · " Foreground="#9A9AA8"/><Run Text="{Binding ContextLabel, Mode=OneWay}" Foreground="#9A9AA8"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <ItemsControl x:Name="ChatList" ItemTemplate="{StaticResource Message}"/>
                            </ScrollViewer>

                            <TextBlock x:Name="EmptyChat" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"
                                       Foreground="#6E6E7C" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" IsHitTestVisible="False"/>

                            <!-- Agente de código sin workspaces -->
                            <Border x:Name="NoWorkspace" Grid.Row="0" Grid.RowSpan="2" CornerRadius="16" BorderThickness="1.5" BorderBrush="#33FFFFFF" Background="#08FFFFFF"
                                    Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="30" HorizontalAlignment="Center" Foreground="#9A9AA8"/>
                                    <TextBlock Text="Abre un workspace" Margin="0,10,0,4" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="#ECECF2"/>
                                    <TextBlock Text="Arrastra la carpeta del proyecto aquí. Cada carpeta es una pestaña; no se puede cambiar: ciérrala y abre otra."
                                               FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Foreground="#9A9AA8"/>
                                    <Button Style="{StaticResource PillButton}" Content="Seleccionar carpeta…" Margin="0,12,0,0" HorizontalAlignment="Center"
                                            Click="NewWorkspace_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Panel de git del workspace (tapa la conversación mientras está abierto; ver NotchWindow.Git.cs) -->
                            <Border x:Name="GitView" Grid.Row="0" Grid.RowSpan="2" CornerRadius="16" Background="#F2141418" BorderBrush="#26FFFFFF"
                                    BorderThickness="1" Padding="12,8,8,10" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="GitBranchButton" Style="{StaticResource PillButton}" Padding="10,4" Background="#2A2A33"
                                                    ToolTip="Cambiar de rama o crear una nueva" Click="GitBranch_Click">
                                                <TextBlock FontSize="12">
                                                    <Run Text="&#x2442;" FontFamily="Segoe UI Symbol" Foreground="#9A9AA8"/>
                                                    <Run x:Name="GitBranchName"/>
                                                    <Run Text="  &#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="#9A9AA8"/>
                                                </TextBlock>
                                            </Button>
                                            <TextBlock x:Name="GitSync" FontSize="11.5" Foreground="#9A9AA8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE710;"
                                                    ToolTip="Preparar todo" Click="GitStageAll_Click"/>
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE738;"
                                                    ToolTip="Quitar todo de lo preparado" Click="GitUnstageAll_Click"/>
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE72C;"
                                                    ToolTip="Actualizar" Click="GitRefresh_Click"/>
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10" Content="&#xE711;"
                                                    ToolTip="Volver a la conversación" Click="GitToggle_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Nueva rama -->
                                    <Border x:Name="GitNewBranchBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="13" Background="#2A2A33" Padding="10,2,4,2" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBox x:Name="GitNewBranchInput" Style="{StaticResource ChatInput}" AcceptsReturn="False" FontSize="12.5"
                                                     MinHeight="24" PreviewKeyDown="GitNewBranch_KeyDown"/>
                                            <TextBlock x:Name="GitNewBranchHint" Text="Nombre de la nueva rama (Enter para crearla, Esc para cancelar)" IsHitTestVisible="False"
                                                       FontSize="12" Foreground="#6E6E7C" VerticalAlignment="Center" Margin="2,0"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer x:Name="GitScroll" Grid.Row="1" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                        <StackPanel x:Name="GitChanges"/>
                                    </ScrollViewer>

                                    <!-- Mensaje del commit -->
                                    <Border Grid.Row="2" Margin="0,8,0,0" CornerRadius="12" Background="#1EFFFFFF" Padding="10,4">
                                        <Grid>
                                            <TextBox x:Name="GitMessage" Style="{StaticResource ChatInput}" FontSize="12.5" MinHeight="40" MaxHeight="110"
                                                     VerticalContentAlignment="Top" Padding="0,4" TextChanged="GitMessage_TextChanged"/>
                                            <TextBlock x:Name="GitMessageHint" IsHitTestVisible="False" FontSize="12" Foreground="#6E6E7C" Margin="2,5,0,0"
                                                       TextWrapping="Wrap" Text="Mensaje del commit… (pulsa el personaje para que el agente lo escriba)"/>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="3" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GitInfo" Style="{StaticResource SelectableText}" FontSize="11.5" Foreground="#9A9AA8"
                                                 VerticalAlignment="Center" MaxHeight="48" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="GitCommitButton" Style="{StaticResource PillButton}" Padding="12,5" Margin="0,0,6,0"
                                                    Background="#7C6CF0" FontWeight="SemiBold" Click="GitCommit_Click">
                                                <TextBlock><Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"/><Run Text="  Commit"/></TextBlock>
                                            </Button>
                                            <Button x:Name="GitPushButton" Style="{StaticResource PillButton}" Padding="12,5" Click="GitPush_Click">
                                                <TextBlock><Run Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="10"/><Run x:Name="GitPushLabel" Text="  Push"/></TextBlock>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Aprobación -->
                        <Border Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Padding="12,10" CornerRadius="14"
                                Background="{StaticResource AlertBg}" BorderBrush="{StaticResource AlertBorder}" BorderThickness="1"
                                Visibility="{Binding PendingApproval, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextPrimary}">
                                    <Run Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AlertBorder}"/>
                                    <Run Text="  "/><Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" quiere usar "/><Run Text="{Binding PendingApproval.Tool, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <Border Margin="0,8,0,8" Padding="8,6" CornerRadius="8" Background="#40000000" MaxHeight="120">
                                    <ScrollViewer Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
                                        <TextBox Style="{StaticResource SelectableText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                 Text="{Binding PendingApproval.Detail, Mode=OneWay}"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PillButton}" Content="Denegar" Click="Deny_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource PillButton}" Content="Permitir siempre" Click="AllowAlways_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource PillButton}" Content="Permitir" Click="Allow_Click"
                                            Background="{StaticResource AlertBorder}" Foreground="#1A1300" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Entrada -->
                        <Border x:Name="InputBar" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Padding="8,4" CornerRadius="20" Background="#1EFFFFFF"
                                Visibility="{Binding CanType, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="6,0">
                                    <TextBox x:Name="Input" Style="{StaticResource ChatInput}" MinHeight="32" MaxHeight="130"
                                             Padding="2,7" PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"/>
                                    <TextBlock x:Name="Placeholder" Text="Continuar… (@ para citar otro workspace)" IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,0"
                                               Foreground="#6E6E7C" FontSize="13.5"/>
                                    <!-- @workspace: lista de los otros workspaces para citarlos como contexto -->
                                    <Popup x:Name="MentionPopup" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom" VerticalOffset="8"
                                           AllowsTransparency="True" StaysOpen="False" Focusable="False" PopupAnimation="Fade">
                                        <Border Background="{StaticResource PaneBg}" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12"
                                                Padding="4" MinWidth="240" MaxWidth="420">
                                            <StackPanel>
                                                <TextBlock Text="CITAR WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#6E6E7C" Margin="8,4,8,4"/>
                                                <ItemsControl x:Name="MentionList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Row" CornerRadius="8" Padding="8,5" Background="Transparent" Cursor="Hand"
                                                                    MouseLeftButtonDown="MentionItem_MouseDown">
                                                                <StackPanel>
                                                                    <TextBlock Foreground="#ECECF1" FontSize="12.5">
                                                                        <Run Text="@" Foreground="#8A8A98"/><Run Text="{Binding Name, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Folder}" Foreground="#6E6E7C" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="#26FFFFFF"/>
                                                                </DataTrigger>
                                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="#1AFFFFFF"/>
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="MentionEmpty" Text="No hay otros workspaces abiertos" Foreground="#6E6E7C" FontSize="12"
                                                           Margin="8,4,8,6" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Detener" Click="Stop_Click"
                                        Foreground="{StaticResource ErrorFg}" VerticalAlignment="Bottom"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE723;" ToolTip="Adjuntar archivos" Click="Attach_Click" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <!-- ============ Tareas programadas ============ -->
                <Border x:Name="ScheduleView" Visibility="Collapsed" Opacity="0" Margin="10,2,10,10" CornerRadius="22"
                        Background="{StaticResource PaneBg}" Padding="14,10,10,12">
                    <ScrollViewer x:Name="ScheduleScroll" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" MaxHeight="430" Padding="0,0,8,0">
                        <StackPanel x:Name="ScheduleContent">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="TAREAS Y RECORDATORIOS" FontSize="10.5" FontWeight="SemiBold" Foreground="#6E6E7C" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Padding="12,3" Click="NewReminder_Click">
                                    <TextBlock><Run Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"/><Run Text="  Nueva"/></TextBlock>
                                </Button>
                            </Grid>
                            <ItemsControl x:Name="ReminderList" ItemTemplate="{StaticResource ScheduledItemTemplate}"/>
                            <TextBlock x:Name="NoReminders" Text="No hay recordatorios ni tareas. Pídeselos a un agente («recuérdame a las 5…») o usa Nueva."
                                       FontSize="12" Foreground="#6E6E7C" TextWrapping="Wrap" Margin="2,2,0,8"/>
                            <TextBlock Text="AGENTES PROGRAMADOS" FontSize="10.5" FontWeight="SemiBold" Foreground="#6E6E7C" Margin="0,12,0,6"/>
                            <ItemsControl x:Name="ScheduledAgentList" ItemTemplate="{StaticResource ScheduledItemTemplate}"/>
                            <TextBlock x:Name="NoScheduledAgents" Text="No hay agentes programados." FontSize="12" Foreground="#6E6E7C" Margin="2,2,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ============ Configuración (agrupada) ============ -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" Opacity="0" Margin="10,2,10,10"
                              Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <Grid x:Name="SettingsContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <!-- Agente actual -->
                            <Border x:Name="SetAgentCard" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock x:Name="SetAgentTitle" Style="{StaticResource SettingsTitle}" Text="AGENTE"/>
                                    <WrapPanel>
                                        <Button x:Name="SetAgentEdit" Style="{StaticResource SettingsButton}" Click="SetAgentEdit_Click">
                                            <TextBlock><Run Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Ajustes del agente"/></TextBlock>
                                        </Button>
                                        <Button x:Name="SetAgentDefault" Style="{StaticResource SettingsButton}" Click="SetAgentDefault_Click">
                                            <TextBlock><Run Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Hacer principal"/></TextBlock>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Crear -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="CREAR"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource SettingsButton}" Click="SetNewChat_Click">
                                            <TextBlock><Run Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Agente de chat"/></TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource SettingsButton}" Click="SetNewScheduled_Click">
                                            <TextBlock><Run Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Agente programado"/></TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource SettingsButton}" Click="SetNewWorkspace_Click">
                                            <TextBlock><Run Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Workspace de código"/></TextBlock>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Notificaciones -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="NOTIFICACIONES"/>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Sonidos"/>
                                        <CheckBox x:Name="SetSounds" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Avisar cuando un agente termina"/>
                                        <CheckBox x:Name="SetNotifyDone" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Avisos de mis sesiones de Claude Code"/>
                                        <CheckBox x:Name="SetClaudeHooks" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Avisos de mis sesiones de Codex"
                                                   ToolTip="Usa la opción notify de ~/.codex/config.toml; si ya la usaba otra app, se le siguen pasando los avisos"/>
                                        <CheckBox x:Name="SetCodexNotify" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsRight" Grid.Column="2">
                            <!-- Panel (accesibilidad) -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="PANEL · ACCESIBILIDAD"/>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Abrir al pasar el ratón"/>
                                        <CheckBox x:Name="SetHover" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,4,46,4">
                                            <TextBlock Text="Ocultar el notch (solo una línea)" FontSize="12.5" Foreground="#ECECF2" TextWrapping="Wrap"/>
                                            <TextBlock Text="Crece al acercar el ratón y se abre con un clic. Los avisos llegan como notificaciones de Windows."
                                                       FontSize="10.5" Foreground="#6E6E7C" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SetHideNotch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/>
                                    </Grid>
                                    <TextBlock Text="Cerrar el panel" FontSize="11.5" Foreground="#9A9AA8" Margin="0,4,0,2"/>
                                    <RadioButton x:Name="SetCloseOutside" Style="{StaticResource Choice}" GroupName="closeMode" Margin="0,4"
                                                 Content="Solo al hacer clic fuera (o Esc)" Click="SettingToggle_Click"/>
                                    <RadioButton x:Name="SetCloseLeave" Style="{StaticResource Choice}" GroupName="closeMode" Margin="0,4,0,2"
                                                 Content="Al sacar el ratón" Click="SettingToggle_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Sistema -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="SISTEMA"/>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Iniciar con Windows"/>
                                        <CheckBox x:Name="SetStartup" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/>
                                    </Grid>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Style="{StaticResource SettingsButton}" Click="SetDataFolder_Click">
                                            <TextBlock><Run Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Carpeta de datos"/></TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource SettingsButton}" Click="SetExit_Click" Foreground="{StaticResource ErrorFg}">
                                            <TextBlock><Run Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Salir"/></TextBlock>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Versión y actualizaciones -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="VERSIÓN"/>
                                    <TextBlock x:Name="SetVersion" FontSize="12.5" Foreground="#ECECF2"/>
                                    <TextBlock x:Name="SetUpdateStatus" FontSize="11.5" Foreground="#9A9AA8" TextWrapping="Wrap" Margin="0,3,0,2"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource SettingsButton}" Click="SetReleaseNotes_Click">
                                            <TextBlock><Run Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Notas de la versión"/></TextBlock>
                                        </Button>
                                        <Button x:Name="SetCheckUpdates" Style="{StaticResource SettingsButton}" Click="SetCheckUpdates_Click">
                                            <TextBlock><Run Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Buscar ahora"/></TextBlock>
                                        </Button>
                                        <Button x:Name="SetUpdateNow" Style="{StaticResource SettingsButton}" Click="SetUpdateNow_Click" Visibility="Collapsed"
                                                Background="#7C6CF0">
                                            <TextBlock><Run Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="10.5"/><Run Text="  Actualizar"/></TextBlock>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                    </Grid>
                </Grid>

                <!-- ============ Aviso con el panel abierto (Claude Code o Codex de la terminal, avisos externos) ============ -->
                <Border x:Name="PanelNotice" Visibility="Collapsed" Opacity="0" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,44,0,0" MaxWidth="520" Padding="10,8,6,8" CornerRadius="14" Cursor="Hand"
                        Background="#2A2A31" BorderBrush="#3A3A44" BorderThickness="1" MouseLeftButtonUp="PanelNotice_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:MochiView x:Name="PanelNoticeMochi" Width="34" Height="34" Interactive="False"/>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PanelNoticeTitle" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PanelNoticeBody" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" VerticalAlignment="Center"
                                Click="PanelNoticeClose_Click" ToolTip="Cerrar"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

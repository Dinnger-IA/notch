<Window x:Class="AgentManagerNotch.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AgentManagerNotch.Controls"
        xmlns:v="clr-namespace:AgentManagerNotch.Views"
        Title="Notas de la versión" Width="900" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <v:NullToVisibilityConverter x:Key="NullToVis"/>
        <v:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral: una pestaña por versión, la más nueva arriba -->
        <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,18,10,10">
                <TextBlock DockPanel.Dock="Top" Text="VERSIONES" FontSize="11" FontWeight="SemiBold" Opacity="0.55" Margin="10,0,0,10"/>
                <ListBox x:Name="VersionList" Background="Transparent" BorderThickness="0" SelectionChanged="VersionList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="6" Background="#337C6CF0" VerticalAlignment="Center"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="instalada" FontSize="10.5" Foreground="#C9C2FF"/>
                                    </Border>
                                    <TextBlock Margin="8,0,0,0" Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="11" Opacity="0.55"
                                               VerticalAlignment="Center" ToolTip="Con vídeo de los cambios"
                                               Visibility="{Binding Gif, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Date}" FontSize="11.5" Opacity="0.55" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenido de la versión seleccionada -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,24">
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="DateText" FontSize="12.5" Opacity="0.6" Margin="0,4,0,0"/>
                <Border x:Name="GifFrame" Margin="0,18,0,0" CornerRadius="12" Background="#0E0E12" BorderBrush="#22FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Left" MaxHeight="380" ClipToBounds="True">
                    <c:GifPlayer x:Name="Gif" Margin="1"/>
                </Border>
                <RichTextBox x:Name="Body" Margin="0,16,0,0" Style="{StaticResource SelectableDoc}" FontSize="13.5" Block.LineHeight="21"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

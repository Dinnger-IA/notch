<Window x:Class="AgentManagerNotch.Views.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recordatorios y tareas" Width="680" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Recordatorios y tareas programadas"/>

        <!-- Formulario de alta -->
        <Border Grid.Row="1" Margin="0,14,0,14" Padding="14" CornerRadius="12" Background="#14FFFFFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="Qué" FontSize="12" Opacity="0.7"/>
                    <TextBox x:Name="WhatBox" Margin="0,4,0,10" ToolTip="Texto del aviso, o instrucción que ejecutará el agente"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Cuándo" FontSize="12" Opacity="0.7"/>
                    <TextBox x:Name="WhenBox" Margin="0,4,0,2" Text="30m" TextChanged="When_Changed"/>
                    <TextBlock x:Name="WhenPreview" FontSize="11" Opacity="0.65" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Repetir" FontSize="12" Opacity="0.7"/>
                    <ComboBox x:Name="RecurrenceBox" Margin="0,4,0,10" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Agente" FontSize="12" Opacity="0.7"/>
                    <ComboBox x:Name="AgentBox" Margin="0,4,0,10" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Tipo" FontSize="12" Opacity="0.7"/>
                    <ComboBox x:Name="KindBox" Margin="0,4,0,10" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <DockPanel Grid.Row="3" Grid.ColumnSpan="3" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxWidth="420"
                               Text="Formatos: 10m · 1h30m · 2 horas · 15:30 · mañana 9:00 · 2026-10-02 09:00. También puedes pedírselo al agente en el chat."/>
                    <Button DockPanel.Dock="Right" Content="Añadir" MinWidth="110" Click="Add_Click" Style="{DynamicResource AccentButtonStyle}"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Lista -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="10" Background="#0FFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" Text="&#xE823;" Opacity="0.8"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11.5" Opacity="0.6" Margin="0,3,0,0">
                                            <Run Text="{Binding DueLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding RecurrenceLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding KindLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" ToolTip="Eliminar"
                                            VerticalAlignment="Center" Click="Delete_Click" Tag="{Binding Id}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                       Text="No hay nada programado todavía."/>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="AgentManagerNotch.Views.UpdateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AgentManagerNotch.Controls">
    <!-- Tarjeta del agente de actualización (en el notch y en los GIF de las notas de la versión) -->
    <Border CornerRadius="22" Background="#121217" Padding="22,16,22,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <c:MochiView x:Name="Mochi" Width="96" Height="96" BodyColor="#7C6CF0" State="Waiting" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Hay una versión nueva" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="NotesText" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="InfoText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="NowButton" Content="Actualizar ahora" MinWidth="130" Click="Now_Click"
                            Style="{DynamicResource AccentButtonStyle}"/>
                    <Button Content="Más tarde" MinWidth="100" Margin="8,0,0,0" Click="Later_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
